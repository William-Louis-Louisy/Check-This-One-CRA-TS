# YOUTUBE
REACT_APP_YTB_API_KEY=YOUR API KEY
REACT_APP_YTB_SEARCH_URL=https://www.googleapis.com/youtube/v3/search?part=snippet&maxResults=10

# TMDB
REACT_APP_TMDB_API_KEY=YOUR API KEY
REACT_APP_TMDB_SEARCH_URL=https://api.themoviedb.org/3/search/movie
# CTO-03b: must be a same-site API origin (or /api through a same-origin proxy).
# Production frontend on *.vercel.app with a separate check-this-one.com API
# requires a domain cutover or same-origin reverse proxy before rollout.
REACT_APP_API_URL=https://YOUR-SAME-SITE-API.example.com
